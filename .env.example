# Application Environment Variables Example

# Timezone & Environment
ENV=production
TZ=Asia/Kolkata
LOG_LEVEL=INFO

# Database Connection (Postgres on Render, or SQLite for local testing)
# SQLite local: sqlite+aiosqlite:///screener.db
# Render Postgres: postgresql+asyncpg://screener_admin:password@host/nse_screener
DATABASE_URL=sqlite+aiosqlite:///screener.db

# Telegram Alert Configuration
# Create bot via @BotFather to get token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Comma-separated list of target chat IDs (channel, group, or user ID)
TELEGRAM_CHAT_IDS=-1001234567890,987654321
# Separate chat ID for system health and exception alerts
ADMIN_CHAT_ID=987654321

# Web Dashboard Security Token
DASHBOARD_TOKEN=quant-admin-secure-2026

# Scanner Frequency (in seconds)
POLL_INTERVAL_SEC=45
TRIGGER_MODE=ltp_above
